# ───────── 本番URL（Vercel では設定不要）
# 本番ドメインは lib/site.ts の productionUrl（https://www.solarshift.jp）に登録してあります。
# Vercel の本番デプロイでは自動でこの URL が使われるので、環境変数の設定は要りません。
# プレビューのデプロイと手元のビルドは、全ページ noindex になります（canonical / OG / sitemap も出しません）。
# 手元で本番と同じ出力を確かめたいとき、または別の URL で公開したいときだけ、ここを設定します。
NEXT_PUBLIC_SITE_URL=
# API ルート等で使う同じ値（NEXT_PUBLIC_SITE_URL が無ければこちらを参照）
SITE_URL=

# ───────── Claude API（ブログ自動投稿と、チャットの AI 回答で共用）
ANTHROPIC_API_KEY=
# 記事を書くモデル（未設定なら claude-sonnet-5-5。Haiku では、公開前の読み直しに通る記事を書けなかった）
ANTHROPIC_MODEL=
# 公開前の読み直しに使うモデル（未設定なら claude-opus-5-5。書くモデルより上のモデルで点検する）
ANTHROPIC_REVIEW_MODEL=
# ───────── チャット（自動応答）
# ANTHROPIC_API_KEY が無い間は「よくある質問」だけで答えます（AI の費用は発生しません）。
# チャットのモデル（未設定なら claude-haiku-4-5）
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
# off にすると AI 回答を止めます（よくある質問だけで答える）
CHATBOT_AI=
# AI 回答の1日あたり上限（未設定なら 300）
CHAT_AI_DAILY_LIMIT=300

# ───────── ブログ自動投稿
# Vercel Cron の認証（Vercel の環境変数に同名で設定すると Cron が自動で Bearer を付けます）
CRON_SECRET=

# ───────── 自動投稿の永続化（Vercel Cron 経由のとき必須。GitHub に記事をコミットして再デプロイを起こす）
# Fine-grained PAT: 対象リポジトリの Contents: Read and write
GITHUB_TOKEN=
# owner/repo
GITHUB_REPO=
GITHUB_BRANCH=main

# ───────── お問い合わせフォーム（Resend。未設定ならフォームはメール案内にフォールバック）
# これだけ入れれば送れる（Resend の「API keys」で作る。権限は Sending access、ドメインは solarshift.jp）
RESEND_API_KEY=
# 送信先を変えたいときだけ（未設定なら lib/site.ts の連絡先メール）
CONTACT_EMAIL_TO=
# 送信元を変えたいときだけ（未設定なら SOLAR SHIFT <noreply@solarshift.jp>。Resend で確認済みのドメインのアドレスにする）
CONTACT_EMAIL_FROM=

# ───────── 検索エンジンの所有権確認（任意。meta タグの content の値だけを入れる）
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
