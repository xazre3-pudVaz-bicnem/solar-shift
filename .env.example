# ───────── 本番URL（必須）
# 未設定のビルドは canonical / OG / sitemap を出さず、全ページ noindex になります（プレビュー誤インデックス防止）。
NEXT_PUBLIC_SITE_URL=https://example.com
# API ルート等で使う同じ値（NEXT_PUBLIC_SITE_URL が無ければこちらを参照）
SITE_URL=https://example.com

# ───────── ブログ自動投稿（Claude API）
ANTHROPIC_API_KEY=
# 使用モデル（未設定なら claude-haiku-4-5）
ANTHROPIC_MODEL=claude-haiku-4-5
# Vercel Cron の認証（Vercel の環境変数に同名で設定すると Cron が自動で Bearer を付けます）
CRON_SECRET=

# ───────── 自動投稿の永続化（Vercel Cron 経由のとき必須。GitHub に記事をコミットして再デプロイを起こす）
# Fine-grained PAT: 対象リポジトリの Contents: Read and write
GITHUB_TOKEN=
# owner/repo
GITHUB_REPO=
GITHUB_BRANCH=main

# ───────── お問い合わせフォーム（Resend。未設定ならフォームはメール案内にフォールバック）
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=SOLAR SHIFT <noreply@example.com>
